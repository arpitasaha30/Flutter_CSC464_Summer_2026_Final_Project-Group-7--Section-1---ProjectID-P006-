rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone signed in (i.e. any doc in /users) can read the user list,
    // but a user document can only be created once and never edited by
    // someone else. Since this project doesn't use Firebase Auth, these
    // rules are intentionally permissive for development — tighten them
    // if you add real authentication later.
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    match /chats/{chatId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
  }
}
